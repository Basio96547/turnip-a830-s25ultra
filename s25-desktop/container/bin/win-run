#!/usr/bin/env bash
set -euo pipefail
# ═══════════════════════════════════════════════════════════════════════
#  win-run — تشغيل أي برنامج ويندوز (.exe / .msi) على الجوال
#            عبر Wine + box64 + DXVK فوق Turnip/Vulkan
#
#  أمثلة:
#     win-run winecfg
#     win-run /mnt/sdcard/Download/setup.exe
#     win-run installer.msi              (يُشغّل تلقائياً عبر msiexec)
#     win-run "C:\\Program Files\\App\\app.exe" --flag
# ═══════════════════════════════════════════════════════════════════════

# shellcheck source=../etc/env.sh
. /opt/s25/etc/env.sh

if [ ! -r /opt/s25/etc/windows.sh ]; then
    printf '✗ طبقة ويندوز غير مثبتة.\n  شغّل: s25-update install-windows-layer.sh\n' >&2
    exit 1
fi
# shellcheck source=/dev/null
. /opt/s25/etc/windows.sh

[ $# -ge 1 ] || { printf '✗ الاستخدام: win-run <ملف.exe|أمر> [وسائط]\n' >&2; exit 1; }

if [ ! -x "${S25_WINE:-}" ]; then
    printf '✗ لم يتم العثور على Wine في %s\n  أعد التثبيت: s25-update install-windows-layer.sh\n' \
        "${S25_WINE:-/opt/s25/windows/wine}" >&2
    exit 1
fi

command -v box64 >/dev/null 2>&1 || { printf '✗ box64 غير مثبت\n' >&2; exit 1; }

# ── كثافة نقاط ويندوز ──────────────────────────────────────────────────
# عند 96 نقطة/بوصة (مبدئي ويندوز) تظهر النوافذ بحجم مجهري على شاشة الجوال.
# نحسب القيمة من عرض شاشة X الفعلي بدل رقم ثابت: كل 480 بكسل عرضاً = ضعف
# واحد، فـ 1440 بكسل ← ثلاثة أضعاف (288). القيمة قابلة للتجاوز بـ S25_WIN_DPI.
win_dpi_auto() {
    local w=0
    if command -v xdpyinfo >/dev/null 2>&1; then
        w="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {split($2,a,"x"); print a[1]; exit}')"
    fi
    case "$w" in ''|*[!0-9]*) w=0 ;; esac
    [ "$w" -lt 480 ] && { printf '288'; return 0; }   # تعذّر القياس ← افتراض شاشة جوال
    local d=$(( 96 * w / 480 ))
    [ "$d" -lt 144 ] && d=144
    [ "$d" -gt 480 ] && d=480
    printf '%s' "$d"
}

S25_WIN_DPI="${S25_WIN_DPI:-$(win_dpi_auto)}"
dpi_marker="${WINEPREFIX:-/nonexistent}/.s25-dpi-$S25_WIN_DPI"
if [ -d "${WINEPREFIX:-/nonexistent}" ] && [ ! -f "$dpi_marker" ]; then
    printf '▶ كثافة نقاط ويندوز: %s (أكبر: S25_WIN_DPI=384 · أصغر: S25_WIN_DPI=192)\n' \
        "$S25_WIN_DPI"
    if box64 "$S25_WINE" reg add 'HKEY_CURRENT_USER\Control Panel\Desktop' \
            /v LogPixels /t REG_DWORD /d "$S25_WIN_DPI" /f >/dev/null 2>&1; then
        rm -f "${WINEPREFIX}"/.s25-dpi-* 2>/dev/null || true
        : > "$dpi_marker"
    else
        printf '⚠ تعذر ضبط الكثافة — ستبقى النوافذ صغيرة (غير حرج)\n' >&2
    fi
fi

TARGET="$1"; shift

# ملفات MSI تحتاج msiexec
case "$TARGET" in
    *.msi|*.MSI) exec box64 "$S25_WINE" msiexec /i "$TARGET" "$@" ;;
esac

exec box64 "$S25_WINE" "$TARGET" "$@"
