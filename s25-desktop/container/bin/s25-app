#!/usr/bin/env bash
set -uo pipefail
# ═══════════════════════════════════════════════════════════════════════
#  s25-app — تشغيل تطبيق واحد مع مدير نوافذ خفيف (بدون سطح مكتب كامل)
#  الاستخدام: s25-app <أمر التطبيق> [وسائط]
#
#  إن فشل التطبيق تُعرض رسالة الخطأ على شاشة X — بدل أن يرى المستخدم
#  شاشة سوداء بمؤشر ماوس ولا يعرف السبب.
# ═══════════════════════════════════════════════════════════════════════

# shellcheck source=../etc/env.sh
. /opt/s25/etc/env.sh

[ $# -ge 1 ] || { printf '✗ الاستخدام: s25-app <أمر> [وسائط]\n' >&2; exit 1; }

WM_PID=""
cleanup() {
    [ -n "$WM_PID" ] && kill "$WM_PID" 2>/dev/null || true
}
# ملاحظة: يُستبدل لاحقاً بـ cleanup_all بعد تعريف لوحة «جارٍ التشغيل»
trap cleanup EXIT

# مدير نوافذ خفيف حتى تكون للنوافذ حدود وأزرار
if command -v openbox >/dev/null 2>&1; then
    openbox >/dev/null 2>&1 &
    WM_PID=$!
    sleep 1
elif command -v xfwm4 >/dev/null 2>&1; then
    xfwm4 >/dev/null 2>&1 &
    WM_PID=$!
    sleep 1
fi

# show_on_screen <عنوان> <نص> — يعرض الرسالة داخل جلسة X
show_on_screen() {
    local title="$1" body="$2"
    # نفس الترتيب: xmessage بلا OpenGL أولاً، ثم zenity برسم برمجي
    if command -v xmessage >/dev/null 2>&1; then
        xmessage -center -title "$title" "$body" >/dev/null 2>&1 && return 0
    fi
    if command -v zenity >/dev/null 2>&1; then
        GSK_RENDERER=cairo zenity --error --width=520 \
            --title="$title" --text="$body" >/dev/null 2>&1 && return 0
    fi
    # آخر خيار: طرفية تبقى مفتوحة وتعرض الرسالة مع التشخيص
    local script="printf '%s\n\n' \"$body\"; /opt/s25/bin/s25-doctor 2>&1 | tail -30; printf '\nاضغط Enter للإغلاق '; read _"
    if command -v xfce4-terminal >/dev/null 2>&1; then
        xfce4-terminal --title="$title" --hold -e "bash -lc \"$script\"" >/dev/null 2>&1 && return 0
    fi
    if command -v xterm >/dev/null 2>&1; then
        xterm -title "$title" -hold -e bash -lc "$script" >/dev/null 2>&1 && return 0
    fi
    return 1
}

APP_NAME="$(basename "$1")"
LOG="${TMPDIR:-/tmp}/s25-$APP_NAME.log"

# لوحة «جارٍ التشغيل» تظهر فوراً: أول إقلاع لبرنامج ويندوز عبر box64 يأخذ
# دقائق، وبلا هذه اللوحة تبدو الشاشة سوداء صامتة فيظن المستخدم أن شيئاً تعطّل.
NOTICE_PID=""
notice_start() {
    local msg="جارٍ تشغيل $APP_NAME…

أول إقلاع لبرنامج ويندوز عبر box64 قد يأخذ من دقيقة إلى عدة دقائق،
وأول تشغيل لـ Claude/Chrome ينزّل المُثبّت الرسمي أيضاً.

ستُغلق هذه اللوحة تلقائياً، وستظهر نافذة البرنامج عند جهوزها.
السجل الحيّ: $LOG"
    # xmessage أولاً: Xlib خالص بلا OpenGL. zenity على trixie هو GTK4 ويحتاج
    # تسريعاً رسومياً عاملاً — فإن كان Vulkan/Zink معطلاً يموت بصمت ولا تُرى لوحة.
    if command -v xmessage >/dev/null 2>&1; then
        xmessage -center -title "S25 · $APP_NAME" "$msg" >/dev/null 2>&1 &
        NOTICE_PID=$!
        return 0
    fi
    if command -v zenity >/dev/null 2>&1; then
        GSK_RENDERER=cairo zenity --info --width=520 \
            --title="S25 · $APP_NAME" --text="$msg" >/dev/null 2>&1 &
        NOTICE_PID=$!
    fi
}
notice_stop() {
    [ -n "$NOTICE_PID" ] && kill "$NOTICE_PID" 2>/dev/null || true
    NOTICE_PID=""
}

cleanup_all() {
    notice_stop
    cleanup
}
trap cleanup_all EXIT

notice_start

if "$@" 2>&1 | tee "$LOG"; then
    notice_stop
    exit 0
fi
notice_stop

# فشل التطبيق — نعرض السبب على الشاشة ونُبقي الجلسة قائمة ليقرأه المستخدم
TAIL="$(tail -12 "$LOG" 2>/dev/null)"
printf '✗ فشل %s — آخر الرسائل:\n%s\n' "$APP_NAME" "$TAIL" >&2
show_on_screen "فشل تشغيل $APP_NAME" "تعذّر تشغيل $APP_NAME.

$TAIL

الأسباب الشائعة:
• التثبيت لم يكتمل — نفّذ:  bash s25-desktop/install.sh
• طبقة ويندوز غير مثبتة — نفّذ:  s25-update install-windows-layer.sh
• للتشخيص الكامل:  s25-doctor

السجل: $LOG" || {
    printf '⚠ تعذر عرض الرسالة على الشاشة — اقرأ السجل: %s\n' "$LOG" >&2
    sleep 20
}
exit 1
